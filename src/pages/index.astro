---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allDocs = await getCollection('docs', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const recentDocs = allDocs
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const allTags = [...new Set(allDocs.flatMap((doc) => doc.data.tags))];

const skills = [
  { name: 'TypeScript', color: '#3178c6' },
  { name: 'Java', color: '#ed8b00' },
  { name: 'React', color: '#61dafb' },
  { name: 'Astro', color: '#bc52ee' },
  { name: 'Node.js', color: '#339933' },
  { name: 'Docker', color: '#2496ed' },
  { name: 'PostgreSQL', color: '#4169e1' },
  { name: 'Git', color: '#f05032' },
];

const heroWords = "Building things that matter".split(' ');
---

<BaseLayout title="Kenny's Space">
  <section class="hero">
    <div class="container hero-content">
      <div class="scroll-fade-up">
        <span class="section-badge">Open to collaborate</span>
      </div>

      <h1 class="hero-title words-pull-up">
        {heroWords.map((word, i) => (
          <span class="word" style={`--delay: ${i * 0.08}s`}>
            {word === 'matter' ? <span class="gradient-text">{word}</span> : word}
          </span>
        ))}
      </h1>

      <p class="hero-subtitle scroll-fade-up scroll-fade-up-delay-200">
        Software Engineer with a passion for clean architecture,
        scalable systems, and developer experience.
      </p>

      <div class="hero-stats scroll-fade-up scroll-fade-up-delay-300">
        <div class="stat">
          <span class="stat-value">{allDocs.length}+</span>
          <span class="stat-label">Articles</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value">{allTags.length}</span>
          <span class="stat-label">Topics</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value">{skills.length}+</span>
          <span class="stat-label">Skills</span>
        </div>
      </div>

      <div class="hero-actions scroll-fade-up scroll-fade-up-delay-400">
        <a href="/docs/" class="btn-gradient">
          Browse Docs
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href="https://github.com/mk100120" class="btn-ghost" target="_blank" rel="noopener">
          GitHub
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">Tech Stack</span>
        <h2 class="section-title">Skills & Tools</h2>
      </div>
      <div class="skills-grid">
        {skills.map((skill, i) => (
          <div
            class="skill-chip glass-card card-glow scroll-fade-up"
            style={`--chip-color: ${skill.color}; --stagger-delay: ${i * 80}`}
          >
            <span class="skill-dot" style={`background: ${skill.color}`}></span>
            <span class="skill-name">{skill.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {recentDocs.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header scroll-fade-up">
          <div>
            <span class="section-badge">Knowledge Base</span>
            <h2 class="section-title">Recent Docs</h2>
          </div>
          <a href="/docs/" class="section-link">
            View all
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
        <div class="docs-grid">
          {recentDocs.map((doc, i) => (
            <a
              href={`/docs/${doc.id}/`}
              class="glass-card card-glow doc-card scroll-fade-up"
              style={`--stagger-delay: ${i * 120}`}
            >
              <div class="doc-meta">
                <time datetime={doc.data.pubDate.toISOString()}>
                  {doc.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3 class="doc-title">{doc.data.title}</h3>
              <p class="doc-desc">{doc.data.description}</p>
              <div class="doc-tags">
                {doc.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <span class="doc-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {allTags.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="scroll-fade-up">
          <span class="section-badge">Categories</span>
          <h2 class="section-title">Explore by Tag</h2>
        </div>
        <div class="tag-cloud scroll-fade-up scroll-fade-up-delay-100">
          {allTags.map((tag) => (
            <a href={`/tags/${tag}/`} class="tag tag-lg">{tag}</a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: 4rem;
  }

  .hero-content { max-width: 740px; }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin: 1rem 0 1.5rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .stat { display: flex; flex-direction: column; }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--glass-border);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section { padding: 5rem 0; }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
    color: var(--text-primary);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .section-header .section-title { margin-bottom: 0; }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--purple-400);
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .section-link:hover { color: var(--text-primary); }

  .section-link:hover svg { transform: translateX(3px); }

  .section-link svg { transition: transform var(--transition-fast); }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.15rem !important;
    cursor: default;
  }

  .skill-chip:hover {
    border-color: var(--chip-color, var(--glass-border-hover)) !important;
  }

  .skill-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px currentColor;
  }

  .skill-name {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .doc-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    cursor: pointer;
    position: relative;
  }

  .doc-meta time {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .doc-title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .doc-card:hover .doc-title {
    color: var(--purple-400);
    text-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
  }

  .doc-desc {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .doc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .doc-arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--text-tertiary);
    opacity: 0;
    transform: translateX(-6px);
    transition: all var(--transition-fast);
  }

  .doc-card:hover .doc-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-lg {
    padding: 0.45rem 1.15rem;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .hero { min-height: 80vh; }
    .hero-actions { flex-direction: column; }
    .hero-stats { gap: 1rem; }
    .docs-grid { grid-template-columns: 1fr; }
    .section-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>
