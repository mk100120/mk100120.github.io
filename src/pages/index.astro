---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allDocs = await getCollection('docs', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const recentDocs = allDocs.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const allBlog = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const recentBlog = allBlog.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const skills = {
  languages: [
    { name: 'Java', level: 95, years: 8 },
    { name: 'TypeScript', level: 92, years: 5 },
    { name: 'JavaScript', level: 90, years: 7 },
    { name: 'Python', level: 78, years: 3 },
    { name: 'SQL', level: 88, years: 6 },
    { name: 'HTML/CSS', level: 94, years: 7 },
  ],
  frontend: ['React', 'Vue.js', 'Astro', 'Next.js', 'Tailwind CSS', 'Svelte'],
  backend: ['Spring Boot', 'Node.js', 'Express.js', 'NestJS', 'GraphQL', 'gRPC'],
  devops: ['Docker', 'Kubernetes', 'GitHub Actions', 'Jenkins', 'AWS', 'Terraform'],
  databases: ['PostgreSQL', 'MongoDB', 'Redis', 'MySQL', 'Elasticsearch'],
};

const projects = [
  { title: 'Cloud Native Platform', type: 'Full Stack', desc: 'Microservices-based enterprise platform with auto-scaling, service mesh, and real-time monitoring dashboard.', tags: ['Java', 'Spring Boot', 'Kubernetes', 'React'], link: '#', github: 'https://github.com/mk100120' },
  { title: 'AI Code Review Bot', type: 'AI/ML', desc: 'Automated code review tool using LLM to analyze PRs, detect anti-patterns, and suggest improvements.', tags: ['Python', 'OpenAI', 'TypeScript', 'GitHub API'], link: '#', github: 'https://github.com/mk100120' },
  { title: 'Real-time Analytics Engine', type: 'Backend', desc: 'High-throughput event processing pipeline handling 100K+ events/sec with sub-second query latency.', tags: ['Java', 'Kafka', 'ClickHouse', 'Grafana'], link: '#', github: 'https://github.com/mk100120' },
  { title: 'DevOps Dashboard', type: 'Web App', desc: 'Unified dashboard for CI/CD pipelines, deployment status, and infrastructure health monitoring.', tags: ['React', 'Node.js', 'Docker', 'WebSocket'], link: '#', github: 'https://github.com/mk100120' },
  { title: 'E-Commerce Storefront', type: 'Full Stack', desc: 'Headless e-commerce platform with SSR, dynamic filtering, payment integration, and inventory management.', tags: ['Next.js', 'Stripe', 'PostgreSQL', 'Redis'], link: '#', github: 'https://github.com/mk100120' },
  { title: 'Knowledge Base System', type: 'Open Source', desc: 'This portfolio site built with Astro, featuring content collections, tag filtering, and glassmorphism UI.', tags: ['Astro', 'TypeScript', 'MDX', 'CSS'], link: '/', github: 'https://github.com/mk100120' },
];

const experience = [
  { role: 'Senior Software Engineer', company: 'Tech Corp', period: 'Mar 2023 - Present', location: 'Shanghai, China', type: 'Full-time', current: true, desc: 'Leading backend architecture and cloud-native transformation for enterprise SaaS platform.', achievements: ['Architected microservices migration reducing deployment time by 60% and improving system reliability to 99.95% uptime', 'Led a team of 6 engineers delivering Spring Boot + Kubernetes platform serving 2M+ daily requests', 'Designed event-driven architecture with Kafka processing 100K+ events/sec with sub-100ms latency', 'Implemented CI/CD pipelines with GitHub Actions achieving 15-minute build-to-production cycles'], tags: ['Java', 'Spring Boot', 'Kubernetes', 'Kafka', 'PostgreSQL', 'AWS'] },
  { role: 'Full Stack Developer', company: 'Digital Studio', period: 'Jun 2021 - Feb 2023', location: 'Shanghai, China', type: 'Full-time', current: false, desc: 'Built modern web applications and internal tools for enterprise clients.', achievements: ['Delivered 8 production web applications with React/Next.js achieving 95+ Lighthouse scores', 'Built real-time collaboration features using WebSocket serving 500+ concurrent users', 'Reduced API response times by 70% through query optimization and Redis caching strategies', 'Mentored 3 junior developers and established code review practices for the team'], tags: ['React', 'Next.js', 'Node.js', 'TypeScript', 'MongoDB', 'Docker'] },
  { role: 'Backend Developer', company: 'StartupX', period: 'Sep 2019 - May 2021', location: 'Beijing, China', type: 'Full-time', current: false, desc: 'Core backend developer for fintech startup building payment processing systems.', achievements: ['Built RESTful APIs handling 50K+ daily transactions with zero downtime', 'Implemented JWT-based auth system with role-based access control for 10K+ users', 'Designed database schema and optimized PostgreSQL queries reducing p95 latency from 300ms to 45ms', 'Integrated third-party payment gateways (Alipay, WeChat Pay) processing $2M+ monthly'], tags: ['Java', 'Spring Boot', 'PostgreSQL', 'Redis', 'Docker', 'RabbitMQ'] },
  { role: 'Junior Developer', company: 'Web Agency', period: 'Jul 2017 - Aug 2019', location: 'Hangzhou, China', type: 'Full-time', current: false, desc: 'Developed responsive websites and web applications for local businesses.', achievements: ['Developed 15+ responsive websites using Vue.js, PHP, and MySQL', 'Built custom CMS reducing client content update time by 80%', 'Created reusable component library used across 10+ projects'], tags: ['Vue.js', 'PHP', 'MySQL', 'JavaScript', 'jQuery'] },
];

const contacts = [
  { label: 'Email', value: 'kenny.dev@example.com', url: 'mailto:kenny.dev@example.com' },
  { label: 'Location', value: 'Shanghai, China', url: null },
];

const socials = [
  { name: 'GitHub', url: 'https://github.com/mk100120', icon: 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z', qr: null },
  { name: 'Twitter', url: 'https://x.com', icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z', qr: null },
  { name: 'LinkedIn', url: 'https://linkedin.com', icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z', qr: null },
  { name: 'WeChat', url: null, icon: 'M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.045c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-7.062-6.122zM14.53 13.39c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982z', qr: 'wechat' },
  { name: 'Douyin', url: null, icon: 'M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z', qr: 'douyin' },
];

const heroWords = "Engineering Tomorrow's Digital Frontier".split(' ');
---

<BaseLayout title="Kenny | Full Stack Developer | Portfolio">

  <!-- ===== HOME ===== -->
  <section id="home" class="hero">
    <div class="container hero-content">
      <div class="scroll-fade-up">
        <span class="available-badge">
          <span class="available-dot"></span>
          Available for opportunities
        </span>
      </div>

      <p class="hero-greeting scroll-fade-up scroll-fade-up-delay-100">Hi, I'm</p>

      <h1 class="hero-title words-pull-up">
        {heroWords.map((word, i) => (
          <span class="word" style={`--delay: ${i * 0.08}s`}>
            {i >= heroWords.length - 2
              ? <span class="gradient-text">{word}</span>
              : word}
          </span>
        ))}
      </h1>

      <h2 class="hero-role scroll-fade-up scroll-fade-up-delay-200">Full Stack Developer</h2>

      <p class="hero-desc scroll-fade-up scroll-fade-up-delay-300">
        Passionate developer creating amazing digital experiences.
      </p>

      <div class="hero-pills scroll-fade-up scroll-fade-up-delay-300">
        <span class="hero-pill">Clean Code</span>
        <span class="hero-pill">Modern UI/UX</span>
        <span class="hero-pill">Fast Performance</span>
      </div>

      <div class="hero-actions scroll-fade-up scroll-fade-up-delay-400">
        <a href="#projects" class="btn-gradient">
          View My Work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href="/resume.pdf" class="btn-ghost">
          Download Resume
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>
      </div>

      <div class="hero-socials scroll-fade-up scroll-fade-up-delay-500">
        {socials.map((s) => (
          s.qr ? (
            <div class="social-icon-wrap">
              <button class="social-icon" title={s.name} aria-label={s.name}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg>
              </button>
              <div class="qr-popover">
                <div class="qr-popover-inner glass-strong">
                  <div class="qr-placeholder">
                    <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
                      <rect width="120" height="120" rx="12" fill="#1e293b"/>
                      <rect x="20" y="20" width="30" height="30" rx="4" fill="#a855f7" opacity="0.8"/>
                      <rect x="70" y="20" width="30" height="30" rx="4" fill="#a855f7" opacity="0.8"/>
                      <rect x="20" y="70" width="30" height="30" rx="4" fill="#a855f7" opacity="0.8"/>
                      <rect x="55" y="55" width="10" height="10" rx="2" fill="#a855f7" opacity="0.6"/>
                      <rect x="70" y="70" width="30" height="30" rx="4" fill="#a855f7" opacity="0.4"/>
                      <rect x="26" y="26" width="18" height="18" rx="2" fill="#0f172a"/>
                      <rect x="76" y="26" width="18" height="18" rx="2" fill="#0f172a"/>
                      <rect x="26" y="76" width="18" height="18" rx="2" fill="#0f172a"/>
                      <rect x="31" y="31" width="8" height="8" rx="1" fill="#a855f7"/>
                      <rect x="81" y="31" width="8" height="8" rx="1" fill="#a855f7"/>
                      <rect x="31" y="81" width="8" height="8" rx="1" fill="#a855f7"/>
                    </svg>
                  </div>
                  <span class="qr-label">{s.name === 'WeChat' ? 'Scan to add WeChat' : 'Scan to follow on Douyin'}</span>
                </div>
              </div>
            </div>
          ) : (
            <a href={s.url} class="social-icon" target="_blank" rel="noopener" title={s.name}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg>
            </a>
          )
        ))}
      </div>

      <div class="scroll-hint scroll-fade-up scroll-fade-up-delay-500">
        <span>Scroll to explore</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">About Me</span>
        <h2 class="section-heading">Professional Background</h2>
        <p class="section-sub">Delivering enterprise-grade solutions with expertise in modern technologies</p>
      </div>

      <div class="about-grid">
        <div class="about-text">
          <p class="about-para scroll-fade-up">
            A seasoned full-stack developer with 7+ years of professional experience in designing, developing, and deploying scalable web applications. Specialized in Java/Spring Boot backend systems and modern React frontends.
          </p>
          <p class="about-para scroll-fade-up scroll-fade-up-delay-100">
            My expertise spans cloud-native architectures, microservices design, and full-stack development. I've successfully led projects from conception to deployment, collaborating with cross-functional teams to deliver solutions that exceed expectations.
          </p>

          <div class="about-highlights">
            <div class="highlight-card glass-card scroll-fade-up">
              <h4 class="highlight-title">Full-Stack Delivery</h4>
              <p class="highlight-desc">7 years shipping Spring Boot and React applications with robust API layers and cloud deployments.</p>
            </div>
            <div class="highlight-card glass-card scroll-fade-up scroll-fade-up-delay-100">
              <h4 class="highlight-title">Performance Engineering</h4>
              <p class="highlight-desc">Reduced API latency by 70% and improved system throughput handling 100K+ events/sec in production.</p>
            </div>
            <div class="highlight-card glass-card scroll-fade-up scroll-fade-up-delay-200">
              <h4 class="highlight-title">Team Leadership</h4>
              <p class="highlight-desc">Led engineering teams of 6+ in Agile environments, mentoring juniors and establishing best practices.</p>
            </div>
          </div>
        </div>

        <div class="about-sidebar scroll-fade-up scroll-fade-up-delay-200">
          <div class="profile-card glass-strong">
            <div class="profile-avatar">K</div>
            <div class="profile-status">
              <span class="status-dot"></span>
              <span>Remote Ready</span>
            </div>
            <h4 class="profile-name">Open for Opportunities</h4>
            <div class="profile-types">
              <span class="tag">Freelance</span>
              <span class="tag">Contract</span>
              <span class="tag">Full-time</span>
            </div>

            <div class="profile-stats">
              <div class="p-stat"><span class="p-stat-value">7+</span><span class="p-stat-label">Years Experience</span></div>
              <div class="p-stat"><span class="p-stat-value">30+</span><span class="p-stat-label">Projects Completed</span></div>
              <div class="p-stat"><span class="p-stat-value">10+</span><span class="p-stat-label">Happy Clients</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SKILLS ===== -->
  <section id="skills" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">Skills & Expertise</span>
        <h2 class="section-heading">What I Bring to the Table</h2>
        <p class="section-sub">A comprehensive toolkit of modern technologies and frameworks</p>
      </div>

      <div class="skills-section">
        <h3 class="skills-cat-title scroll-fade-up">Languages</h3>
        <div class="skills-bars">
          {skills.languages.map((s, i) => (
            <div class="skill-bar-card glass-card scroll-fade-up" style={`--stagger-delay: ${i * 100}`}>
              <div class="skill-bar-header">
                <span class="skill-bar-name">{s.name}</span>
                <span class="skill-bar-years">{s.years} years</span>
              </div>
              <div class="skill-bar-track">
                <div class="skill-bar-fill" style={`--fill: ${s.level}%`}></div>
              </div>
              <span class="skill-bar-pct">{s.level}%</span>
            </div>
          ))}
        </div>
      </div>

      <div class="skills-tags-grid">
        {Object.entries({ 'Frontend': skills.frontend, 'Backend': skills.backend, 'DevOps & Cloud': skills.devops, 'Databases': skills.databases }).map(([cat, items]) => (
          <div class="skills-tag-group scroll-fade-up">
            <h4 class="skills-tag-cat">{cat}</h4>
            <div class="skills-tag-list">
              {items.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PROJECTS ===== -->
  <section id="projects" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">Portfolio</span>
        <h2 class="section-heading">Featured Projects</h2>
        <p class="section-sub">A showcase of work demonstrating creativity and technical excellence</p>
      </div>

      <div class="projects-grid">
        {projects.map((p, i) => (
          <div class="project-card glass-card card-glow scroll-fade-up" style={`--stagger-delay: ${i * 120}`}>
            <div class="project-type">{p.type}</div>
            <h3 class="project-title">{p.title}</h3>
            <p class="project-desc">{p.desc}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <div class="project-links">
              {p.link !== '#' && (
                <a href={p.link} class="project-link" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Live
                </a>
              )}
              <a href={p.github} class="project-link" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                Code
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="projects-more scroll-fade-up">
        <a href="https://github.com/mk100120" class="btn-ghost" target="_blank" rel="noopener">
          Explore More on GitHub
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== BLOG ===== -->
  <section id="blog" class="section">
    <div class="container">
      <div class="section-header-row scroll-fade-up">
        <div>
          <span class="section-badge">Blog & Docs</span>
          <h2 class="section-heading">Latest Writing</h2>
        </div>
        <div class="section-header-links">
          <a href="/blog/" class="section-link">Blog &rarr;</a>
          <a href="/docs/" class="section-link">Docs &rarr;</a>
        </div>
      </div>

      <div class="blog-grid">
        {[...recentBlog, ...recentDocs].slice(0, 4).map((post, i) => (
          <a
            href={`/${'data' in post && post.data.tags ? (allBlog.includes(post) ? 'blog' : 'docs') : 'docs'}/${post.id}/`}
            class="glass-card card-glow blog-card scroll-fade-up"
            style={`--stagger-delay: ${i * 100}`}
          >
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <h3 class="blog-card-title">{post.data.title}</h3>
