---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const allDocs = await getCollection('docs', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const recentDocs = allDocs.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const allBlog = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const recentBlog = allBlog.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const { skills, projects, experience, socials, contact, about } = siteConfig;

const contacts = [
  { label: 'Email', value: contact.email, url: `mailto:${contact.email}` },
  { label: 'Location', value: contact.location, url: null },
];

const heroText = "Hi, I'm Engineering Come From Tomorrow";
const heroWords = heroText.split(' ');
const gradientIndices = new Set([0, heroWords.length - 2, heroWords.length - 1]);
---

<BaseLayout title={siteConfig.title}>

  <!-- ===== HOME ===== -->
  <section id="home" class="hero">
    <div class="container hero-content">
      <div class="scroll-fade-up hero-center">
        <span class="available-badge">
          <span class="available-dot"></span>
          Available for opportunities
        </span>
      </div>

      <h1 class="hero-title words-pull-up hero-center">
        {heroWords.map((word, i) => (
          <span class="word" style={`--delay: ${i * 0.08}s`}>
            {gradientIndices.has(i)
              ? <span class="gradient-text">{word}</span>
              : word}
          </span>
        ))}
      </h1>

      <h2 class="hero-role scroll-fade-up scroll-fade-up-delay-200 hero-center">{siteConfig.heroRole}</h2>

      <p class="hero-desc scroll-fade-up scroll-fade-up-delay-300 hero-center">
        {siteConfig.heroDesc}
      </p>

      <div class="hero-pills scroll-fade-up scroll-fade-up-delay-300 hero-center">
        {siteConfig.heroPills.map((pill) => (
          <span class="hero-pill">{pill}</span>
        ))}
      </div>

      <div class="hero-actions scroll-fade-up scroll-fade-up-delay-400 hero-center">
        <a href="#projects" class="btn-gradient">
          View My Work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href={siteConfig.resumeUrl} class="btn-ghost">
          Download Resume
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>
      </div>

      <div class="scroll-hint scroll-fade-up scroll-fade-up-delay-500">
        <button class="scroll-indicator" onclick="document.getElementById('about')?.scrollIntoView({behavior:'smooth'})">
          <div class="scroll-arrows">
            <span class="scroll-arrow"></span>
            <span class="scroll-arrow"></span>
            <span class="scroll-arrow"></span>
          </div>
          <span class="scroll-label">Scroll to explore</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">About Me</span>
        <h2 class="section-heading">Professional Background</h2>
        <p class="section-sub">Delivering enterprise-grade solutions with expertise in modern technologies</p>
      </div>

      <div class="about-grid">
        <div class="about-text">
          {about.paragraphs.map((p, i) => (
            <p class={`about-para scroll-fade-up ${i > 0 ? 'scroll-fade-up-delay-100' : ''}`}>{p}</p>
          ))}

          <div class="about-highlights">
            {about.highlights.map((h, i) => (
              <div class="highlight-card glass-card scroll-fade-up" style={`--stagger-delay: ${i * 100}`}>
                <h4 class="highlight-title">{h.title}</h4>
                <p class="highlight-desc">{h.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="about-sidebar scroll-fade-up scroll-fade-up-delay-200">
          <div class="profile-card glass-strong">
            <img class="profile-avatar" src={siteConfig.avatar} alt={siteConfig.name} width="88" height="88" />
            <div class="profile-status">
              <span class="status-dot"></span>
              <span>Remote Ready</span>
            </div>
            <h4 class="profile-name">Open for Opportunities</h4>
            <div class="profile-types">
              {about.openFor.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>

            <div class="profile-stats">
              <div class="p-stat"><span class="p-stat-value">{about.yearsExperience}</span><span class="p-stat-label">Years Experience</span></div>
              <div class="p-stat"><span class="p-stat-value">{about.projectsCompleted}</span><span class="p-stat-label">Projects Completed</span></div>
              <div class="p-stat"><span class="p-stat-value">{about.happyClients}</span><span class="p-stat-label">Happy Clients</span></div>
            </div>

            <div class="profile-divider"></div>

            <div class="profile-contact">
              <h5 class="profile-contact-title">Connect With Me</h5>
              <div class="profile-socials">
                {socials.map((s) => (
                  s.qr ? (
                    <button
                      class="profile-social-btn"
                      title={s.name}
                      aria-label={s.name}
                      data-qr={s.qr}
                      data-qr-image={s.qrImage}
                      data-qr-label={s.name === 'WeChat' ? 'Scan to add WeChat' : 'Scan to follow on Douyin'}
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg>
                    </button>
                  ) : (
                    <a href={s.url} class="profile-social-btn" target="_blank" rel="noopener" title={s.name}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg>
                    </a>
                  )
                ))}
              </div>
              <div class="profile-qr-area" id="profile-qr-area">
                <div class="profile-qr-inner">
                  <div class="profile-qr-img">
                    <img id="profile-qr-img" src="" alt="QR Code" />
                  </div>
                  <span class="profile-qr-text" id="profile-qr-text"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SKILLS ===== -->
  <section id="skills" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">Skills & Expertise</span>
        <h2 class="section-heading">What I Bring to the Table</h2>
        <p class="section-sub">A comprehensive toolkit of modern technologies and frameworks</p>
      </div>

      <div class="skills-section">
        <h3 class="skills-cat-title scroll-fade-up">Languages</h3>
        <div class="skills-bars">
          {skills.languages.map((s, i) => (
            <div class="skill-bar-card glass-card scroll-fade-up" style={`--stagger-delay: ${i * 100}`}>
              <div class="skill-bar-header">
                <span class="skill-bar-name">{s.name}</span>
                <span class="skill-bar-years">{s.years} years</span>
              </div>
              <div class="skill-bar-track">
                <div class="skill-bar-fill" style={`--fill: ${s.level}%`}></div>
              </div>
              <span class="skill-bar-pct">{s.level}%</span>
            </div>
          ))}
        </div>
      </div>

      <div class="skills-tags-grid">
        {Object.entries({ 'Frontend': skills.frontend, 'Backend': skills.backend, 'DevOps & Cloud': skills.devops, 'Databases': skills.databases }).map(([cat, items]) => (
          <div class="skills-tag-group scroll-fade-up">
            <h4 class="skills-tag-cat">{cat}</h4>
            <div class="skills-tag-list">
              {items.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PROJECTS ===== -->
  <section id="projects" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">Portfolio</span>
        <h2 class="section-heading">Featured Projects</h2>
        <p class="section-sub">A showcase of work demonstrating creativity and technical excellence</p>
      </div>

      <div class="projects-grid">
        {projects.map((p, i) => (
          <div class="project-card glass-card card-glow scroll-fade-up" style={`--stagger-delay: ${i * 120}`}>
            <div class="project-type">{p.type}</div>
            <h3 class="project-title">{p.title}</h3>
            <p class="project-desc">{p.desc}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <div class="project-links">
              {p.link !== '#' && (
                <a href={p.link} class="project-link" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Live
                </a>
              )}
              <a href={p.github} class="project-link" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                Code
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="projects-more scroll-fade-up">
        <a href={socials.find(s => s.name === 'GitHub')?.url ?? '#'} class="btn-ghost" target="_blank" rel="noopener">
          Explore More on GitHub
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== BLOG ===== -->
  <section id="blog" class="section">
    <div class="container">
      <div class="section-header-row scroll-fade-up">
        <div>
          <span class="section-badge">Blog & Docs</span>
          <h2 class="section-heading">Latest Writing</h2>
        </div>
        <div class="section-header-links">
          <a href="/blog/" class="section-link">Blog &rarr;</a>
          <a href="/docs/" class="section-link">Docs &rarr;</a>
        </div>
      </div>

      <div class="blog-grid">
        {[...recentBlog, ...recentDocs].slice(0, 4).map((post, i) => (
          <a
            href={`/${'data' in post && post.data.tags ? (allBlog.includes(post) ? 'blog' : 'docs') : 'docs'}/${post.id}/`}
            class="glass-card card-glow blog-card scroll-fade-up"
            style={`--stagger-delay: ${i * 100}`}
          >
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <h3 class="blog-card-title">{post.data.title}</h3>
            <p class="blog-card-desc">{post.data.description}</p>
            <div class="blog-card-tags">
              {post.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== EXPERIENCE ===== -->
  <section id="experience" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">Career Journey</span>
        <h2 class="section-heading">Professional Experience</h2>
        <p class="section-sub">A timeline of growth, achievements, and continuous learning</p>
      </div>

      <div class="timeline">
        <div class="timeline-center-line"></div>
        {experience.map((exp, i) => (
          <div class={`timeline-item ${i % 2 === 0 ? 'tl-left' : 'tl-right'} scroll-fade-up`} style={`--stagger-delay: ${i * 150}`}>
            <div class="timeline-dot-wrap">
              <div class={`timeline-dot ${exp.current ? 'dot-current' : ''}`}></div>
            </div>
            <div class="timeline-content glass-card card-glow">
              {exp.current && <span class="current-badge">Current Position</span>}
              <h3 class="exp-role">{exp.role}</h3>
              <div class="exp-meta">
                <span class="exp-company">{exp.company}</span>
                <span class="exp-divider">|</span>
                <span>{exp.period}</span>
              </div>
              <div class="exp-meta-sub">
                <span>{exp.location}</span>
                <span class="exp-type-badge">{exp.type}</span>
              </div>
              <p class="exp-desc">{exp.desc}</p>
              <ul class="exp-achievements">
                {exp.achievements.map((a) => <li>{a}</li>)}
              </ul>
              <div class="exp-tags">
                {exp.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section id="contact" class="section">
    <div class="container">
      <div class="scroll-fade-up">
        <span class="section-badge">Get In Touch</span>
        <h2 class="section-heading">Let's Start a Conversation</h2>
        <p class="section-sub">Have a project in mind? Let's build something amazing together</p>
      </div>

      <div class="contact-grid">
        <div class="contact-left">
          <div class="contact-cards">
            {contacts.map((c, i) => (
              <a href={c.url || '#'} class="glass-card contact-info-card scroll-fade-up" style={`--stagger-delay: ${i * 100}`}>
                <span class="contact-card-label">{c.label}</span>
                <span class="contact-card-value">{c.value}</span>
              </a>
            ))}
          </div>

          <div class="contact-socials scroll-fade-up scroll-fade-up-delay-200">
            <h4 class="contact-socials-title">Connect With Me</h4>
            <div class="contact-social-icons">
              {socials.map((s) => (
                <a href={s.url} class="social-icon-lg" target="_blank" rel="noopener" title={s.name}>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg>
                </a>
              ))}
            </div>
          </div>

          <div class="why-card glass-strong scroll-fade-up scroll-fade-up-delay-300">
            <h4 class="why-title">Why Work With Me?</h4>
            <ul class="why-list">
              <li>Fast response time (usually within 24 hours)</li>
              <li>Clear communication throughout the project</li>
              <li>Flexible and adaptable to your needs</li>
              <li>Commitment to quality and deadlines</li>
            </ul>
          </div>
        </div>

        <div class="contact-right">
          <div class="glass-strong contact-form-card scroll-fade-up scroll-fade-up-delay-100">
            <h3 class="form-title">Send Me a Message</h3>
            <p class="form-desc">Have a project in mind? Let's build something amazing together</p>
            <form class="contact-form" id="contact-form">
              <div class="form-field">
                <label for="name">Your Name</label>
                <input type="text" id="name" required autocomplete="name" placeholder="John Doe" />
              </div>
              <div class="form-field">
                <label for="email">Your Email</label>
                <input type="email" id="email" required autocomplete="email" placeholder="john@example.com" />
              </div>
              <div class="form-field">
                <label for="subject">Subject</label>
                <input type="text" id="subject" required placeholder="Project Inquiry" />
              </div>
              <div class="form-field">
                <label for="message">Message</label>
                <textarea id="message" rows="5" required placeholder="Tell me about your project..."></textarea>
              </div>
              <button type="submit" class="btn-gradient form-submit">
                Send Message
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const qrArea = document.getElementById('profile-qr-area') as HTMLElement | null;
    const qrImg = document.getElementById('profile-qr-img') as HTMLImageElement | null;
    const qrText = document.getElementById('profile-qr-text') as HTMLElement | null;
    let activeQr: string | null = null;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;

    function calcQrSize(): number {
      if (!qrArea) return 0;
      const card = qrArea.closest('.profile-card') as HTMLElement | null;
      if (!card) return 0;
      const cardRect = card.getBoundingClientRect();
      const areaRect = qrArea.getBoundingClientRect();
      const viewportBottom = window.innerHeight;
      const spaceBelow = viewportBottom - areaRect.top - 40;
      const maxByCard = 260;
      const available = Math.min(spaceBelow, maxByCard);
      return available;
    }

    function showQr(el: HTMLElement) {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      const qr = el.dataset.qr!;
      const space = calcQrSize();
      if (space < 80) return;

      activeQr = qr;
      document.querySelectorAll('.profile-social-btn').forEach(b => b.classList.remove('active'));
      el.classList.add('active');

      const imgSize = Math.min(Math.max(space - 40, 80), 200);

      if (qrImg) {
        qrImg.src = el.dataset.qrImage || '';
        qrImg.alt = el.dataset.qrLabel || 'QR Code';
        const isDouyin = qr === 'douyin';
        qrImg.style.objectPosition = isDouyin ? 'center 33%' : 'center 55%';
        qrImg.style.transform = isDouyin ? 'scale(2)' : 'scale(1.15)';
        qrImg.style.width = imgSize + 'px';
        qrImg.style.height = imgSize + 'px';
        qrImg.style.borderRadius = isDouyin ? '50%' : '6px';
      }
      if (qrText) qrText.textContent = el.dataset.qrLabel || '';
      if (qrArea) {
        qrArea.style.maxHeight = (imgSize + 50) + 'px';
        qrArea.classList.add('open');
      }
    }

    function hideQr() {
      hideTimer = setTimeout(() => {
        activeQr = null;
        document.querySelectorAll('.profile-social-btn').forEach(b => b.classList.remove('active'));
        if (qrArea) {
          qrArea.classList.remove('open');
          qrArea.style.maxHeight = '0';
        }
      }, 100);
    }

    document.querySelectorAll('.profile-social-btn[data-qr]').forEach((btn) => {
      const el = btn as HTMLElement;
      el.addEventListener('mouseenter', () => showQr(el));
      el.addEventListener('mouseleave', hideQr);
    });

    if (qrArea) {
      qrArea.addEventListener('mouseenter', () => { if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; } });
      qrArea.addEventListener('mouseleave', hideQr);
    }

    const skillObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('.skill-bar-fill').forEach((bar) => {
            const el = bar as HTMLElement;
            el.style.width = el.style.getPropertyValue('--fill');
          });
          entry.target.querySelectorAll('.skill-bar-pct').forEach((pct, i) => {
            const el = pct as HTMLElement;
            const target = parseInt(el.textContent || '0');
            let current = 0;
            const increment = Math.ceil(target / 40);
            const timer = setInterval(() => {
              current = Math.min(current + increment, target);
              el.textContent = current + '%';
              if (current >= target) clearInterval(timer);
            }, 25);
          });
          skillObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.skills-bars').forEach((el) => {
      el.querySelectorAll('.skill-bar-fill').forEach((bar) => {
        (bar as HTMLElement).style.width = '0%';
      });
      skillObserver.observe(el);
    });

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = form?.querySelector('.form-submit') as HTMLButtonElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span class="btn-spinner"></span> Sending...`;
      setTimeout(() => {
        submitBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Sent!`;
        submitBtn.style.background = 'linear-gradient(135deg, #059669, #10b981)';
        setTimeout(() => {
          form.reset();
          submitBtn.disabled = false;
          submitBtn.innerHTML = `Send Message <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>`;
          submitBtn.style.background = '';
        }, 2000);
      }, 1200);
    });
  </script>

</BaseLayout>

<style>
  .available-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.1rem 0.4rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .available-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
    animation: pulse-available 2s ease-in-out infinite;
  }

  @keyframes pulse-available {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(74, 222, 128, 0.6); }
    50% { opacity: 0.5; box-shadow: 0 0 16px rgba(74, 222, 128, 0.3); }
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
