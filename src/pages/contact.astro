---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import { siteConfig } from '../config/site';

const githubSocial = siteConfig.socials.find(s => s.name === 'GitHub');

const contacts = [
  {
    label: 'GitHub',
    value: githubSocial?.url?.split('/').pop() ?? '',
    url: githubSocial?.url ?? '#',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="${githubSocial?.icon ?? ''}"/></svg>`,
  },
  {
    label: 'Email',
    value: siteConfig.contact.email,
    url: `mailto:${siteConfig.contact.email}`,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
  ...siteConfig.socials.filter(s => s.name !== 'GitHub' && s.url).map(s => ({
    label: s.name,
    value: s.name === 'Twitter' ? '@kenny' : s.name,
    url: s.url!,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="${s.icon}"/></svg>`,
  })),
  ...siteConfig.socials.filter(s => !s.url).map(s => ({
    label: s.name,
    value: s.name === 'WeChat' ? 'scan to add' : 'scan to follow',
    url: null as string | null,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="${s.icon}"/></svg>`,
  })),
];
---

<BaseLayout title="Contact">
  <div class="page-top"></div>
  <div class="container page-container">
    <div class="page-header animate-in">
      <h1 class="page-title">Contact</h1>
      <p class="page-desc">有想法想交流？随时联系我。</p>
    </div>

    <div class="contact-grid">
      {contacts.map((c) => {
        const Tag = c.url ? 'a' : 'div';
        return (
          <Tag
            href={c.url || undefined}
            target={c.url?.startsWith('http') ? '_blank' : undefined}
            rel={c.url?.startsWith('http') ? 'noopener' : undefined}
            class="glass-card contact-card animate-in"
          >
            <div class="contact-icon" set:html={c.icon} />
            <div class="contact-info">
              <span class="contact-label">{c.label}</span>
              <span class="contact-value">{c.value}</span>
            </div>
            {c.url && (
              <span class="contact-arrow">→</span>
            )}
          </Tag>
        );
      })}
    </div>

    <div class="message-section animate-in">
      <div class="glass message-box">
        <h2 class="message-title">Or leave a message</h2>
        <p class="message-desc">
          也可以直接在 <a href={githubSocial?.url ?? '#'} target="_blank" rel="noopener">GitHub</a> 上给我提 Issue，我会第一时间看到。
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-top { height: var(--nav-height); }

  .page-container {
    padding-top: 3rem;
    padding-bottom: 4rem;
    max-width: 680px;
  }

  .page-header { margin-bottom: 2.5rem; }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .page-desc {
    color: var(--text-tertiary);
    font-size: 1rem;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgba(139, 92, 246, 0.1);
    color: var(--accent-purple);
    flex-shrink: 0;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .contact-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-value {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .contact-arrow {
    color: var(--text-tertiary);
    font-size: 1.1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--transition-fast);
  }

  .contact-card:hover .contact-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .message-section { margin-top: 1rem; }

  .message-box {
    padding: 2rem;
    text-align: center;
  }

  .message-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .message-desc {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

  .message-desc a {
    color: var(--accent-purple);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .message-desc a:hover {
    color: var(--accent-cyan);
  }
</style>
